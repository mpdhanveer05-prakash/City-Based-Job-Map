{
  "name": "company-map",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/copy-maplibre.mts && node scripts/build-datasets.mts --seed-fallback",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre.mts && node scripts/build-datasets.mts --require && node scripts/check-build-config.mts && node -e \"require('node:fs').rmSync('.next/dev',{recursive:true,force:true})\"",
    "build": "next build",
    "postbuild": "node scripts/fix-segment-files.mts out && node scripts/inject-csp.mts out && node scripts/check-static-limits.mts out",
    "lint": "eslint",
    "pretypecheck": "node -e \"require('node:fs').rmSync('.next/dev',{recursive:true,force:true})\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "wrangler dev --port 8788",
    "deploy:staging": "wrangler deploy --env staging",
    "fixtures": "node map/fixtures/cli.mts",
    "test:parity": "vitest run --config vitest.parity.config.ts",
    "data": "node scripts/build-datasets.mts",
    "audit": "node scripts/audit-gate.mts",
    "gate": "playwright test --config playwright.gate.config.ts",
    "test:admin": "playwright test --config playwright.admin.config.ts",
    "test-stack": "node scripts/test-stack.mts",
    "test:db": "node scripts/test-stack.mts test-db"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-virtual": "^3.14.22",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "comlink": "4.4.2",
    "kdbush": "4.1.0",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.15.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "supercluster": "9.1.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "pg": "8.23.1",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
