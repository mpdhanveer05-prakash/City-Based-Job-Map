{
  "name": "company-map",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/copy-maplibre.mts",
    "dev": "next dev",
    "prebuild": "node scripts/copy-maplibre.mts && node -e \"require('node:fs').rmSync('.next/dev',{recursive:true,force:true})\"",
    "build": "next build",
    "postbuild": "node scripts/check-static-limits.mts out",
    "lint": "eslint",
    "pretypecheck": "node -e \"require('node:fs').rmSync('.next/dev',{recursive:true,force:true})\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "wrangler dev --port 8788",
    "deploy:staging": "wrangler deploy --env staging",
    "fixtures": "node map/fixtures/cli.mts",
    "test:parity": "vitest run --config vitest.parity.config.ts",
    "data": "node scripts/build-datasets.mts",
    "gate": "playwright test --config playwright.gate.config.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "comlink": "4.4.2",
    "kdbush": "4.1.0",
    "lucide-react": "^1.49.0",
    "maplibre-gl": "^6.11.2",
    "next": "16.3.8",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.0",
    "supercluster": "9.1.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "pg": "8.23.1",
    "supabase": "^2.118.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0"
  }
}
