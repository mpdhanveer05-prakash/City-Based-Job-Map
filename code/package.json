{
  "name": "company-map",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node -e \"require('node:fs').rmSync('.next/dev',{recursive:true,force:true})\"",
    "build": "next build",
    "postbuild": "node scripts/check-static-limits.mts out",
    "lint": "eslint",
    "pretypecheck": "node -e \"require('node:fs').rmSync('.next/dev',{recursive:true,force:true})\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "wrangler dev --port 8788",
    "deploy:staging": "wrangler deploy --env staging"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.7",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2",
    "wrangler": "^4.144.0"
  }
}
