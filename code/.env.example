# Copy to .env.local. Placeholders only; never commit real values.

# --- Build settings (read at build time; the static export bakes them in) ---
# DEV_ROUTES=on includes /dev/* (design tokens, map prototype) in a build (staging).
# They are always on under `npm run dev`. Leave unset for production.
# DEV_ROUTES=on
# SITE_ENV=staging makes the build noindex (robots.txt Disallow + meta). Unset = production.
# SITE_ENV=staging

# Where `npm run build` reads the city datasets (ADR-0010). With a Supabase URL and anon key below it
# reads that project; with LOCAL_DATABASE_URL it reads a local database; DATA_SOURCE=seed uses the
# committed synthetic sample (supabase/seed/snapshots). With none of them the build fails.
# DATA_SOURCE=seed
# RELEASE_BUILD=1 is for the production deploy only: it makes the build refuse synthetic data.
# PILOT_PREVIEW=1 is for the local pilot preview only (data/pilot/bangalore/README.md); RELEASE_BUILD=1 refuses it.
# PILOT_PREVIEW=1
# Deploy checks (scripts/check-deploy-env.mts) read DEPLOY_ENV, SUPABASE_PROJECT_REF, OTHER_ENV_SUPABASE_PROJECT_REF and
# ALLOW_SYNTHETIC_DATA. They are GitHub environment variables (staging/production), not local settings: do not set them here.
# See docs/deploy-environments.md.

# --- Browser-safe (NEXT_PUBLIC_ is bundled into client code) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-or-publishable-key
# Restrict it to your hosts in Geoapify MyProjects > API Keys (localhost:3000, :3100, :8788, staging).
NEXT_PUBLIC_GEOAPIFY_KEY=replace-with-referrer-restricted-key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-site-key

# Local development only: `npm run data` can read a local Postgres as the anon role instead of Supabase's REST API.
# LOCAL_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Tests only: the disposable test stack (node scripts/test-stack.mts start), port 55322. Tests refuse any other database,
# including the main local one on 54322.
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# --- Server-only. NEVER in the Next.js app or NEXT_PUBLIC_ (ADR-0006) ---
# Supabase Edge Function secrets (`supabase secrets set`), set in Supabase, not in the Next.js app:
SUPABASE_SERVICE_ROLE_KEY=replace-server-only
TURNSTILE_SECRET_KEY=replace-server-only
GITHUB_DISPATCH_TOKEN=replace-server-only
# Comma-separated site origins the functions accept requests from (click, submit-feedback, request-rebuild).
ALLOWED_ORIGINS=replace-with-comma-separated-origins
# Salt for hashing a visitor's address for the submit-feedback rate limit.
FEEDBACK_SALT=replace-server-only
# owner/repo that request-rebuild sends the repository_dispatch to.
GITHUB_REPOSITORY=replace-with-owner/repo
# GitHub Actions secrets for `wrangler deploy` (token: Account > Workers Scripts: Edit):
CLOUDFLARE_API_TOKEN=replace-server-only
CLOUDFLARE_ACCOUNT_ID=replace-server-only

# --- Pipeline (GitHub Actions only; least-privilege DB role) ---
PIPELINE_DATABASE_URL=postgresql://pipeline_role:replace@localhost:54322/postgres
# Unused until the geocoding provider is decided (D-07); nothing reads it yet.
GEOCODER_API_KEY=replace-provider-undecided-D-07
