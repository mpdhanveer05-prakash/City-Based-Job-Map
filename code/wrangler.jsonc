{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Assets-only Worker serving the static export (ADR-0006, ADR-0007): no script,
  // so requests are free, unlimited, and use no CPU. This is what Cloudflare now
  // ships as Pages. Production = `company-map`; staging = `wrangler deploy --env staging`.
  "name": "company-map",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./out",
    // Missing paths get out/404.html with a real 404 status.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "env": {
    "staging": {
      "name": "company-map-staging"
    }
  }
}
